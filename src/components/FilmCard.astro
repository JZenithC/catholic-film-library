---
import Artwork from './Artwork.astro';
import { url, type Film } from '../data/catalogue';
interface Props {
  film: Film;
  index?: number;
  headingLevel?: 2 | 3;
}
const { film, index = 0, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const href = url(`films/${film.slug}/`);
const director = film.directors[0];
---

<article class="film-card">
  <a class="art-link" href={href} tabindex="-1" aria-hidden="true">
    <Artwork
      filmId={film.id}
      title={film.title}
      year={film.year}
      director={director}
      variant={index}
    />
  </a>
  {film.grey && <p class="grey-tag">Grey area</p>}
  <Heading><a href={href}>{film.title}</a></Heading>
  <p class="card-meta">
    {film.year}{director ? ` · ${director}` : ''}
  </p>
  <p class="card-summary">{film.summary}</p>
</article>
