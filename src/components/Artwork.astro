---
import { posterFor } from '../data/posters';
import { url, kindLabel } from '../data/catalogue';
interface Props {
  filmId?: string;
  title: string;
  year?: number;
  director?: string;
  variant?: number;
  priority?: boolean;
  /** Set when the surrounding link already names the film. */
  decorative?: boolean;
}
const {
  filmId,
  title,
  year,
  director,
  variant = 0,
  priority = false,
  decorative = false,
} = Astro.props;
const poster = posterFor(filmId);
const label = poster ? kindLabel(poster.kind) : '';
---

{
  poster ? (
    <div class:list={['poster-art', { 'small-source': poster.width < 300 }]}>
      <img
        src={url(poster.src)}
        width={poster.width}
        height={poster.height}
        alt={decorative ? '' : `${label}: ${title}${year ? ` (${year})` : ''}`}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </div>
  ) : (
    <div
      class:list={[
        'title-card',
        `c${Math.abs(variant) % 3}`,
        { dense: title.length > 26 },
      ]}
      aria-hidden="true"
    >
      <span class="tc-year">{year}</span>
      <span class="tc-title">{title}</span>
      <span class="tc-dir">{director}</span>
    </div>
  )
}
