---
import '../styles/global.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import serifRegular from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import serifMedium from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import serifItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-italic.woff2?url';
import bodyRegular from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import { url } from '../data/catalogue';
interface Props {
  title: string;
  description?: string;
  movie?: Record<string, unknown>;
  noindex?: boolean;
}
const {
  title,
  description = 'A guide to Catholic films, from silent classics to recent work: what each film is, what it does well, what it invents and what to know before watching.',
  movie,
  noindex = false,
} = Astro.props;
const siteName = 'The Catholic Film Library';
const isHome = title === 'Home';
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  ['library/', 'Films'],
  ['essentials/', 'Start here'],
  ['collections/', 'Collections'],
  ['saints/', 'Saints'],
  ['grey-area/', 'Grey area'],
  ['guides/', 'Guides'],
  ['about/', 'About'],
];
const path = Astro.url.pathname;
const current = (href: string) => {
  const target = url(href);
  if (href === 'library/' && path.startsWith(url('films/'))) return 'page';
  return path.startsWith(target) ? 'page' : undefined;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {[serifRegular, serifMedium, serifItalic, bodyRegular].map((href) => (
      <link
        rel="preload"
        href={href}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    ))}
    <title>{isHome ? siteName : `${title} · ${siteName}`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="New films"
      href={url('feed.xml')}
    />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={isHome ? siteName : title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={movie ? 'video.movie' : 'website'} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta
      property="og:image"
      content={new URL(url('social.png'), Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    {movie && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(movie).replace(/</g, '\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url()}>
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M8.5 1h3v5.5H17v3h-5.5V19h-3V9.5H3v-3h5.5z" fill="currentColor" />
          </svg>
          <span>{siteName}</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          {links.map(([href, label]) => (
            <a href={url(href)} aria-current={current(href)}>
              {label}
            </a>
          ))}
        </nav>
        <details class="mobile-nav">
          <summary>
            Menu
            <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true" focusable="false">
              <path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.6" />
            </svg>
          </summary>
          <nav aria-label="Main (mobile)">
            {links.map(([href, label]) => (
              <a href={url(href)} aria-current={current(href)}>
                {label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          <a class="footer-title" href={url()}>{siteName}</a>
          <p>
            An independent guide to films about the Catholic faith, with notes
            on each film's history, treatment of the faith and suitability.
          </p>
          <p>
            Recommendations are editorial judgments, not statements of the
            Church.
          </p>
        </div>
        <nav aria-labelledby="footer-browse">
          <h2 id="footer-browse">Browse</h2>
          <a href={url('library/')}>Films</a>
          <a href={url('essentials/')}>Start here</a>
          <a href={url('collections/')}>Collections</a>
          <a href={url('grey-area/')}>Grey area</a>
          <a href={url('saints/')}>Saints</a>
          <a href={url('calendar/')}>Calendar</a>
          <a href={url('guides/')}>Guides</a>
          <a href={url('family/')}>Watching with children</a>
          <a href={url('new/')}>New films</a>
          <a href={url('a-z/')}>A–Z</a>
          <a href={url('print/')}>Printable list</a>
          <a href={url('not-included/')}>Films not included</a>
        </nav>
        <nav aria-labelledby="footer-about">
          <h2 id="footer-about">About</h2>
          <a href={url('principles/')}>How films are chosen</a>
          <a href={url('about/')}>About</a>
          <a href={url('sources/')}>Sources and research</a>
          <a href={url('image-credits/')}>Image credits</a>
          <a href={url('corrections/')}>Corrections</a>
          <a href={url('catalogue.json')}>Catalogue data</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var menu = document.querySelector('.mobile-nav');
        if (!menu) return;
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary').focus();
          }
        });
        menu.addEventListener('click', function (e) {
          if (e.target.closest('nav a')) menu.open = false;
        });
        document.addEventListener('click', function (e) {
          if (menu.open && !menu.contains(e.target)) menu.open = false;
        });
      })();
    </script>
  </body>
</html>
