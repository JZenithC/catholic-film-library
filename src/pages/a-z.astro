---
import Layout from '../layouts/Layout.astro';
import { publicFilms, url } from '../data/catalogue';
const entries = publicFilms
  .flatMap((f) =>
    [
      ...new Set(
        [f.title, f.originalTitle, ...f.alternateTitles].filter(Boolean),
      ),
    ].map((t) => ({ title: t!, film: f })),
  )
  .sort((a, b) => a.title.localeCompare(b.title, 'en'));
const letter = (s: string) =>
  s
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .charAt(0)
    .toUpperCase();
const letters = [...new Set(entries.map((e) => letter(e.title)))].sort();
---

<Layout
  title="A–Z"
  description="Every film by English title, original title and other release titles."
>
  <div class="wrap">
    <div class="page-heading">
      <h1>A–Z</h1>
      <p class="lead">
        Every film by English title, original title and other release titles.
        Each one leads to the same film page. Films in the grey area are marked.
      </p>
    </div>
    <nav class="index-nav" aria-label="Letters">
      {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
    </nav>
    {
      letters.map((l) => (
        <section class="index-group" id={`letter-${l}`}>
          <h2>{l}</h2>
          <ul>
            {entries
              .filter((e) => letter(e.title) === l)
              .map((e) => (
                <li>
                  <a href={url(`films/${e.film.slug}/`)}>{e.title}</a>
                  {e.film.grey && <span class="grey-tag">Grey area</span>}
                  <small>
                    {e.film.year}
                    {e.title !== e.film.title ? ` · see ${e.film.title}` : ''}
                  </small>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
    <div class="section"></div>
  </div>
</Layout>
