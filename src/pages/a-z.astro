---
import Layout from '../layouts/Layout.astro';
import { films, url } from '../data/catalogue';
const entries = films
  .flatMap((f) =>
    [
      ...new Set(
        [f.title, f.originalTitle, ...f.alternateTitles].filter(Boolean),
      ),
    ].map((t) => ({ title: t!, film: f })),
  )
  .sort((a, b) => a.title.localeCompare(b.title, 'en'));
const letter = (s: string) =>
  s
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .charAt(0)
    .toUpperCase();
const letters = [...new Set(entries.map((e) => letter(e.title)))].sort();
---

<Layout title="A–Z Index">
  <div class="wrap">
    <div class="page-heading">
      <span class="eyebrow">Titles and their translations</span>
      <h1>The A–Z Index</h1>
      <p class="lead">
        English titles, original titles and verified release alternatives, all
        leading to the same permanent profile.
      </p>
    </div>
    <nav class="index-nav" aria-label="Index letters">
      {letters.map((l) => (
        <a href={`#letter-${l}`}>{l}</a>
      ))}
    </nav>
    {letters.map((l) => (
      <section class="index-group" id={`letter-${l}`}>
        <h2>{l}</h2>
        <ul>
          {entries
            .filter((e) => letter(e.title) === l)
            .map((e) => (
              <li>
                <a href={url(`films/${e.film.slug}/`)}>{e.title}</a>
                <small>
                  {e.film.year}
                  {e.title !== e.film.title ? ` · ${e.film.title}` : ''}
                </small>
              </li>
            ))}
        </ul>
      </section>
    ))}
    <div class="section"></div>
  </div>
</Layout>
