---
import Layout from '../layouts/Layout.astro';
import Artwork from '../components/Artwork.astro';
import { publicFilms as films, url, kindLabel } from '../data/catalogue';
import { posters } from '../data/posters';
const credits = posters
  .map((poster) => ({ poster, film: films.find((f) => f.id === poster.id) }))
  .filter(
    (c): c is { poster: (typeof posters)[number]; film: (typeof films)[number] } =>
      c.film !== undefined,
  )
  .sort((a, b) => a.film.title.localeCompare(b.film.title, 'en'));
---

<Layout
  title="Image credits"
  description="Where each poster and release cover on the site comes from, and its copyright status."
>
  <div class="wrap">
    <div class="reading">
      <div class="page-heading">
        <h1>Image credits</h1>
        <p class="lead">
          The posters and release covers on film pages and in film lists, with
          their sources.
        </p>
      </div>
      <div class="prose">
        <p>
          Most of these images are copyrighted. They are shown small, uncropped
          and at low resolution, to identify the film being written about, and
          they are not offered for download or reuse. Where a source records an
          image as public domain, the entry below says so.
        </p>
        <p>
          A source link credits where the image was found; it is not a claim
          that the image is freely licensed. If you hold the rights to an image
          and want it removed, use the “Image or rights request” form on the{' '}
          <a href={url('corrections/')}>corrections page</a>. Images are removed
          promptly.
        </p>
      </div>
      {
        credits.map(({ poster, film }) => (
          <section class="credit" id={poster.id} aria-labelledby={`h-${poster.id}`}>
            <Artwork filmId={film.id} title={film.title} year={film.year} />
            <div>
              <h2 id={`h-${poster.id}`}>
                <a href={url(`films/${film.slug}/`)}>
                  {film.title} ({film.year})
                </a>
              </h2>
              <p>
                {kindLabel(poster.kind)}. {poster.credit}
              </p>
              {poster.sourceRightsStatement && (
                <p class="muted">{poster.sourceRightsStatement}</p>
              )}
              <p class="small">
                <a href={poster.sourcePage} rel="noopener noreferrer">
                  Source page
                </a>
                {poster.filePage && (
                  <>
                    {' · '}
                    <a href={poster.filePage} rel="noopener noreferrer">
                      File record
                    </a>
                  </>
                )}
                {' · '}Checked <time datetime={poster.reviewed}>{poster.reviewed}</time>
              </p>
            </div>
          </section>
        ))
      }
    </div>
    <div class="section"></div>
  </div>
</Layout>
