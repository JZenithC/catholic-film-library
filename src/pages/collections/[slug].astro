---
import Layout from '../../layouts/Layout.astro';
import FilmCard from '../../components/FilmCard.astro';
import { collections, films, url } from '../../data/catalogue';
export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.id },
    props: { collection },
  }));
}
const { collection } = Astro.props;
const selection = films.filter((f) => f.collections.includes(collection.id));
---

<Layout title={collection.title} description={collection.description}>
  <div class="wrap">
    <div class="page-heading">
      <div class="breadcrumbs">
        <a href={url('collections/')}>Collections</a> / {selection.length} films
      </div>
      <h1>{collection.title}</h1>
      <p class="lead">{collection.description}</p>
    </div>
    {selection.length ? (
      <div>
        <h2 class="visually-hidden">Films in this collection</h2>
        <div class="film-grid">
          {selection.map((f, i) => (
            <FilmCard film={f} index={i} />
          ))}
        </div>
      </div>
    ) : (
      <div class="empty">
        <h2>A subject still under research</h2>
        <p>
          No film in this collection has yet met the Library’s publication
          evidence threshold.
        </p>
        <a class="text-link" href={url('corrections/')}>
          Suggest a well-documented film →
        </a>
      </div>
    )}
    <div class="section"></div>
  </div>
</Layout>
