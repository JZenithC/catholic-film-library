---
import Layout from '../../layouts/Layout.astro';
import FilmCard from '../../components/FilmCard.astro';
import { posterFor } from '../../data/posters';
import {
  collections,
  filmsIn,
  greyIn,
  featured,
  publicInOrder,
  collectionCount,
  url,
} from '../../data/catalogue';
export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.id },
    props: { collection },
  }));
}
const { collection } = Astro.props;
const ids = new Set(filmsIn(collection.id).map((f) => f.id));
const selection = featured.filter((f) => ids.has(f.id));
// Grey-area films follow the recommendations in their own sub-list.
const greyIds = new Set(greyIn(collection.id).map((f) => f.id));
const greySelection = publicInOrder.filter((f) => greyIds.has(f.id));
const count = collectionCount(collection.id);
// Heading strip: up to four recommended films with posters, each linking to its review.
const strip = selection
  .map((f) => ({ film: f, poster: posterFor(f.id) }))
  .filter((t) => t.poster)
  .slice(0, 4);
---

<Layout title={collection.title} description={collection.description}>
  <div class="wrap">
    <div class:list={['page-heading', { 'has-strip': strip.length >= 2 }]}>
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={url('collections/')}>Collections</a> / {collection.group}
        </nav>
        <h1>{collection.title}</h1>
        <p class="lead">{collection.description}</p>
        {count && <p class="muted">{count}</p>}
      </div>
      {
        strip.length >= 2 && (
          <div class="heading-strip" aria-hidden="true">
            {strip.map(({ film, poster }) => (
              <a href={url(`films/${film.slug}/`)} tabindex="-1">
                <img
                  src={url(poster!.src)}
                  width={poster!.width}
                  height={poster!.height}
                  alt=""
                  decoding="async"
                />
              </a>
            ))}
          </div>
        )
      }
    </div>
    {
      collection.gap && (
        <div class="collection-gap">
          {selection.length === 0 && (
            <p>
              <strong>
                {greySelection.length
                  ? 'No recommended films here yet.'
                  : 'No films here yet.'}
              </strong>
            </p>
          )}
          <p>{collection.gap}</p>
          <p>
            <a class="text-link" href={url('corrections/')}>
              Suggest a film
            </a>
          </p>
        </div>
      )
    }
    {
      selection.length > 0 && (
        <section aria-labelledby="films-heading">
          <h2 id="films-heading" class="visually-hidden">
            Films
          </h2>
          <div class="film-grid">
            {selection.map((f, i) => (
              <FilmCard film={f} index={i} />
            ))}
          </div>
        </section>
      )
    }
    {
      greySelection.length > 0 && (
        <section class="grey-sublist" aria-labelledby="grey-heading">
          <h2 id="grey-heading">In the grey area</h2>
          <p class="muted">
            Films in this collection that are not recommended without
            qualification. Each page sets out the question.{' '}
            <a href={url('grey-area/')}>About the grey area</a>
          </p>
          <div class="film-grid">
            {greySelection.map((f, i) => (
              <FilmCard film={f} index={selection.length + i} />
            ))}
          </div>
        </section>
      )
    }
    {
      selection.length === 0 && greySelection.length === 0 && !collection.gap && (
        <div class="empty">
          <h2>No films here yet</h2>
          <p>
            Films for this collection are still being researched. If you know
            one that belongs here, suggest it.
          </p>
          <a class="text-link" href={url('corrections/')}>
            Suggest a film
          </a>
        </div>
      )
    }
    <div class="section"></div>
  </div>
</Layout>
