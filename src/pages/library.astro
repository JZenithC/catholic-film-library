---
import Layout from '../layouts/Layout.astro';
import FilmCard from '../components/FilmCard.astro';
import {
  films,
  publicFilms,
  publicInOrder,
  collections,
  collectionCount,
  url,
} from '../data/catalogue';
// Facets cover grey-area films too, so they work when those are included.
const unique = (pick: (f: (typeof films)[number]) => string | string[]) =>
  [...new Set(publicFilms.flatMap((f) => pick(f) ?? []).filter(Boolean))].sort(
    (a, b) => a.localeCompare(b, 'en'),
  );
const facets: [string, string, string[][]][] = [
  [
    'collection',
    'Collection',
    collections
      .filter((c) => collectionCount(c.id))
      .map((c) => [c.id, c.title]),
  ],
  ['subject', 'Subject', unique((f) => f.subjects).map((v) => [v, v])],
  ['country', 'Country', unique((f) => f.countries).map((v) => [v, v])],
  ['language', 'Language', unique((f) => f.languages).map((v) => [v, v])],
  ['format', 'Format', unique((f) => f.format).map((v) => [v, v])],
  ['period', 'Period', unique((f) => f.historicalPeriod).map((v) => [v, v])],
  [
    'decade',
    'Decade',
    [...new Set(publicFilms.map((f) => Math.floor(f.year / 10) * 10))]
      .sort((a, b) => a - b)
      .map((d) => [String(d), `${d}s`]),
  ],
];
const searchData = publicInOrder.map(
  ({
    id,
    title,
    originalTitle,
    alternateTitles,
    directors,
    countries,
    languages,
    subjects,
    collections,
    format,
    historicalPeriod,
    year,
    featured,
    themes,
    grey,
  }) => ({
    id,
    title,
    originalTitle,
    alternateTitles,
    directors,
    countries,
    languages,
    subjects,
    collections,
    format,
    historicalPeriod,
    year,
    featured,
    themes,
    grey: grey?.kind ?? null,
  }),
);
---

<Layout
  title="Films"
  description={`All ${films.length} recommended films in The Catholic Film Library, searchable by title, saint, director, country, language and decade.`}
>
  <div class="wrap">
    <div class="page-heading">
      <h1>Films</h1>
      <p class="lead">
        All {films.length} recommended films. Search by title, saint or
        director, or narrow the list by subject, country, language or decade.
        Grey-area films are left out unless you include them.
      </p>
    </div>
    <form class="searchbar" id="filters" role="search" method="get">
      <label>
        <span class="visually-hidden">Search films</span>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Search titles, saints, directors…"
          autocomplete="off"
        />
      </label>
    </form>
    <noscript>
      <p class="muted">
        Search and filters need JavaScript. All recommended films are listed
        below. The <a href={url('grey-area/')}>grey-area films</a> have their
        own page, and the A–Z works without it.
      </p>
    </noscript>
    <div class="library">
      <aside class="js-only" aria-label="Filters">
        <details class="filters" id="filter-panel" open>
          <summary>Filters</summary>
          <div class="filter-fields">
            {
              facets.map(([id, label, options]) => (
                <label class="field" for={id}>
                  {label}
                  <select id={id} name={id} form="filters">
                    <option value="">Any</option>
                    {options.map(([value, text]) => (
                      <option value={value}>{text}</option>
                    ))}
                  </select>
                </label>
              ))
            }
            <div class="check-field">
              <label for="grey">
                <input id="grey" name="grey" type="checkbox" value="1" form="filters" />
                Include grey-area films
              </label>
              <a href={url('grey-area/')}>What this means</a>
            </div>
            <button type="reset" class="reset" form="filters">
              Clear all filters
            </button>
          </div>
        </details>
      </aside>
      <div>
        <div class="result-bar">
          <p id="result-count" role="status" aria-live="polite">
            {films.length} films
          </p>
          <label class="field js-only" for="sort">
            Sort
            <select id="sort" name="sort" form="filters">
              <option value="featured">Recommended order</option>
              <option value="title">Title A–Z</option>
              <option value="oldest">Oldest first</option>
              <option value="newest">Newest first</option>
            </select>
          </label>
        </div>
        <p class="grey-hint" id="grey-hint" hidden>
          <span id="grey-hint-text"></span>
          <button type="button" class="reset" id="grey-include">
            Include them
          </button>
        </p>
        <h2 class="visually-hidden">Results</h2>
        <div class="film-grid" id="film-results">
          {
            publicInOrder.map((film, index) => (
              <div data-film={film.id} hidden={film.grey !== null}>
                <FilmCard film={film} index={index} />
              </div>
            ))
          }
        </div>
        <div class="empty" id="empty" hidden>
          <h2>No films match</h2>
          <p>Check the spelling, or remove a filter.</p>
          <button type="button" class="reset" id="clear-empty">
            Clear search and filters
          </button>
        </div>
      </div>
    </div>
    <div class="section"></div>
  </div>
  <script
    id="search-data"
    type="application/json"
    set:html={JSON.stringify(searchData).replace(/</g, '\\u003c')}
  />
  <script>
    import { selectFilms } from '../scripts/search.mjs';
    const form = document.querySelector<HTMLFormElement>('#filters')!;
    const panel = document.querySelector<HTMLDetailsElement>('#filter-panel')!;
    const data = JSON.parse(
      document.querySelector('#search-data')!.textContent!,
    );
    const grid = document.querySelector('#film-results')!;
    const count = document.querySelector('#result-count')!;
    const empty = document.querySelector<HTMLElement>('#empty')!;
    const greyBox = document.querySelector<HTMLInputElement>('#grey')!;
    const greyHint = document.querySelector<HTMLElement>('#grey-hint')!;
    const greyHintText = document.querySelector('#grey-hint-text')!;
    const isCheckbox = (el: Element): el is HTMLInputElement =>
      el instanceof HTMLInputElement && el.type === 'checkbox';
    const cards = new Map(
      Array.from(grid.children).map((el) => [
        (el as HTMLElement).dataset.film,
        el as HTMLElement,
      ]),
    );
    // Selects sit outside the <form> element and join it via form="filters",
    // so listen on each field rather than relying on event bubbling.
    const fields = Array.from(form.elements).filter(
      (el): el is HTMLInputElement | HTMLSelectElement =>
        el instanceof HTMLInputElement || el instanceof HTMLSelectElement,
    );
    // Filters are always open on wide screens and start closed on narrow
    // ones unless a filter is already active.
    const wide = window.matchMedia('(min-width: 901px)');
    const keepOpen = () => {
      if (wide.matches && !panel.open) panel.open = true;
    };
    if (!wide.matches) panel.open = false;
    wide.addEventListener('change', keepOpen);
    panel.addEventListener('toggle', keepOpen);
    function readURL() {
      const params = new URLSearchParams(location.search);
      for (const el of fields) {
        if (isCheckbox(el)) {
          el.checked = params.get(el.name) === el.value;
          continue;
        }
        el.value =
          params.get(el.name) ?? (el.name === 'sort' ? 'featured' : '');
        if (el instanceof HTMLSelectElement && el.selectedIndex < 0)
          el.selectedIndex = 0;
      }
      if (
        greyBox.checked ||
        fields.some(
          (el) =>
            el instanceof HTMLSelectElement && el.name !== 'sort' && el.value,
        )
      )
        panel.open = true;
    }
    function update(write = true) {
      const params = new URLSearchParams();
      for (const el of fields)
        params.set(el.name, isCheckbox(el) ? (el.checked ? el.value : '') : el.value);
      const query = Object.fromEntries(params);
      const selected = selectFilms(data, query);
      for (const el of cards.values()) el.hidden = true;
      for (const film of selected) {
        const el = cards.get(film.id)!;
        el.hidden = false;
        grid.append(el);
      }
      const films = (n: number) => `${n} ${n === 1 ? 'film' : 'films'}`;
      const grey = selected.filter((f: { grey: string | null }) => f.grey).length;
      count.textContent =
        films(selected.length) + (grey ? `, ${grey} in the grey area` : '');
      empty.hidden = selected.length > 0;
      // A search that would also match grey-area films says so.
      const hidden = greyBox.checked || !query.q?.trim()
        ? 0
        : selectFilms(data, { ...query, grey: '1' }).length - selected.length;
      greyHint.hidden = hidden === 0;
      greyHintText.textContent = `${hidden === 1 ? '1 grey-area film also matches' : `${hidden} grey-area films also match`}.`;
      if (write) {
        for (const [k, v] of [...params])
          if (!v || (k === 'sort' && v === 'featured')) params.delete(k);
        history.replaceState(
          null,
          '',
          location.pathname + (params.size ? '?' + params : '') + location.hash,
        );
      }
    }
    for (const el of fields) {
      el.addEventListener(
        el instanceof HTMLInputElement && !isCheckbox(el) ? 'input' : 'change',
        () => update(),
      );
    }
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      update();
    });
    form.addEventListener('reset', () => setTimeout(() => update(), 0));
    document
      .querySelector('#clear-empty')!
      .addEventListener('click', () => form.reset());
    document.querySelector('#grey-include')!.addEventListener('click', () => {
      greyBox.checked = true;
      update();
    });
    window.addEventListener('popstate', () => {
      readURL();
      update(false);
    });
    readURL();
    update(false);
  </script>
</Layout>
