---
import Layout from '../layouts/Layout.astro';
import { url } from '../data/catalogue';
---

<Layout title="Page not found">
  <div class="wrap section">
    <div class="page-heading">
      <span class="eyebrow">404 · A missing page</span>
      <h1>Let’s find your film.</h1>
      <p class="lead">
        This address does not lead to a page in the Library. A title may have
        changed, or the link may be incomplete.
      </p>
      <a class="button" href={url('library/')}>
        Search the library →
      </a>
      <p>
        <a class="text-link" href={url('a-z/')}>
          Browse the A–Z index
        </a>
      </p>
    </div>
  </div>
</Layout>
