---
import Layout from '../layouts/Layout.astro';
import {
  films,
  featured,
  collections,
  collectionCount,
  plural,
  url,
} from '../data/catalogue';
const starters = featured.slice(0, 6);
const subjects = collections.filter((c) => c.group === 'Subjects');
const decadeCounts = new Map<number, number>();
for (const f of films) {
  const d = Math.floor(f.year / 10) * 10;
  decadeCounts.set(d, (decadeCounts.get(d) ?? 0) + 1);
}
const decades = [...decadeCounts.entries()].sort((a, b) => a[0] - b[0]);
---

<Layout title="Home">
  <div class="wrap home-hero">
    <div>
      <span class="eyebrow">A guide to Catholic film</span>
      <h1>Catholic films worth your time, from the silent era to now.</h1>
      <p class="lead">
        {films.length} films about saints, priests, martyrs, monks and nuns, and
        the life of Christ. Each profile says what the film is, what it does
        well, what it invents and what to know before watching, judged from a
        traditional Catholic standpoint.
      </p>
      <form class="hero-search" action={url('library/')} method="get" role="search">
        <label class="visually-hidden" for="home-q">Search films</label>
        <input
          id="home-q"
          name="q"
          type="search"
          placeholder="Search titles, saints, directors…"
          autocomplete="off"
        />
        <button class="button" type="submit">Search</button>
      </form>
      <p class="hero-links">
        <a class="text-link" href={url('library/')}>Browse all films</a>
        <a class="text-link" href={url('essentials/')}>Start here</a>
        <a class="text-link" href={url('principles/')}>How films are chosen</a>
      </p>
    </div>
    <div class="contents">
      <h2>Start here</h2>
      <ol>
        {
          starters.map((f) => (
            <li>
              <a href={url(`films/${f.slug}/`)}>{f.title}</a>
              <span class="yr">{f.year}</span>
              <span class="by">
                {[f.directors[0], f.countries[0]].filter(Boolean).join(' · ')}
              </span>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href={url('essentials/')}>
        Twelve films to start with <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <section class="band" aria-labelledby="by-subject">
    <div class="wrap"><div class="section">
      <div class="section-head">
        <h2 id="by-subject">Browse by subject</h2>
        <a class="text-link" href={url('collections/')}>
          All collections <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="topic-grid">
        {
          subjects.map((c) => {
            const count = collectionCount(c.id);
            return (
              <a
                class:list={['topic', { 'is-empty': !count }]}
                href={url(`collections/${c.id}/`)}
              >
                <h3>{c.title}</h3>
                <p>{c.description}</p>
                <span class="count">{count || 'Under review'}</span>
              </a>
            );
          })
        }
      </div>
    </div></div>
  </section>

  <section class="wrap" aria-labelledby="by-decade"><div class="section">
    <div class="section-head">
      <h2 id="by-decade">By decade</h2>
      <p>
        Films from the {decades[0]?.[0]}s to the {decades.at(-1)?.[0]}s.
      </p>
    </div>
    <div class="decades">
      {
        decades.map(([d, n]) => (
          <a href={url(`library/?decade=${d}`)}>
            <b>{d}s</b>
            <span>{plural(n, 'film')}</span>
          </a>
        ))
      }
    </div>
  </div></section>

  <section class="wrap" aria-labelledby="approach"><div class="section approach">
    <h2 id="approach">How films are chosen</h2>
    <div>
      <p>
        A film is included when the Catholic faith is central to it: the Mass
        and the sacraments, a saint's life, a priest's or a nun's vocation, a
        persecution of the Church. A sympathetic priest in a supporting role is
        not enough. Films are judged by Catholic teaching as it was understood
        before the Second Vatican Council; that is a standard, not a date, so
        recent films qualify on the same terms as old ones.
      </p>
      <p>
        Each profile draws on published criticism, history and production
        records, and lists its sources. Where a film bends the facts, the
        profile says so.
      </p>
      <a class="text-link" href={url('principles/')}>
        Read how films are chosen <span aria-hidden="true">→</span>
      </a>
      <p class="grey-pointer">
        Some films are worth knowing about but come with a question attached: a
        reservation about their doctrine or history, or no independent review
        yet. They are kept apart, with the question set out on each page.
        <a class="text-link" href={url('grey-area/')}>
          The grey area <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div></section>
</Layout>
