---
import Layout from '../layouts/Layout.astro';
import Artwork from '../components/Artwork.astro';
import TopicTile from '../components/TopicTile.astro';
import { posterFor } from '../data/posters';
import {
  films,
  featured,
  collections,
  plural,
  url,
} from '../data/catalogue';
// The large hero images are limited to public-domain and openly licensed
// posters; each still links to its film's review.
const FREE = new Set(['public-domain-us', 'public-domain-worldwide', 'open-licence']);
const heroFilms = featured
  .map((f) => ({ film: f, poster: posterFor(f.id) }))
  .filter((t) => FREE.has(t.poster?.rightsCategory ?? ''))
  .slice(0, 3);
const starters = featured.slice(0, 6);
const subjects = collections.filter((c) => c.group === 'Subjects');
const decadeCounts = new Map<number, number>();
for (const f of films) {
  const d = Math.floor(f.year / 10) * 10;
  decadeCounts.set(d, (decadeCounts.get(d) ?? 0) + 1);
}
const decades = [...decadeCounts.entries()].sort((a, b) => a[0] - b[0]);
---

<Layout title="Home">
  <div class="hero-band">
    <div class="wrap home-hero">
      <div>
        <span class="eyebrow">A guide to Catholic film</span>
        <h1>Catholic films worth your time, from the silent era to now.</h1>
        <p class="lead">
          {films.length} films about saints, priests, martyrs, monks and nuns,
          and the life of Christ. Each profile says what the film is, what it
          does well, what it invents and what to know before watching, judged
          from a traditional Catholic standpoint.
        </p>
        <form class="hero-search" action={url('library/')} method="get" role="search">
          <label class="visually-hidden" for="home-q">Search films</label>
          <input
            id="home-q"
            name="q"
            type="search"
            placeholder="Search titles, saints, directors…"
            autocomplete="off"
          />
          <button class="button" type="submit">Search</button>
        </form>
        <p class="hero-links">
          <a class="text-link" href={url('library/')}>Browse all films</a>
          <a class="text-link" href={url('essentials/')}>Start here</a>
          <a class="text-link" href={url('principles/')}>How films are chosen</a>
        </p>
      </div>
      {
        heroFilms.length > 0 && (
          <ul class="hero-posters" aria-label="Featured films">
            {heroFilms.map(({ film }, i) => (
              <li class={`hp${i}`}>
                <a href={url(`films/${film.slug}/`)}>
                  <Artwork
                    filmId={film.id}
                    title={film.title}
                    year={film.year}
                    director={film.directors[0]}
                    priority={i === 0}
                    decorative
                  />
                  <span class="hp-caption">
                    {film.title} <span>{film.year}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <section class="wrap" aria-labelledby="start-here"><div class="section">
    <div class="section-head">
      <h2 id="start-here">Start here</h2>
      <a class="text-link" href={url('essentials/')}>
        Twelve films to start with <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol class="shelf">
      {
        starters.map((f, i) => (
          <li>
            <a href={url(`films/${f.slug}/`)}>
              <Artwork
                filmId={f.id}
                title={f.title}
                year={f.year}
                director={f.directors[0]}
                variant={i}
                decorative
              />
              <span class="shelf-title">{f.title}</span>
              <span class="shelf-meta">
                {[f.year, f.directors[0]].filter(Boolean).join(' · ')}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div></section>

  <section class="band" aria-labelledby="by-subject">
    <div class="wrap"><div class="section">
      <div class="section-head">
        <h2 id="by-subject">Browse by subject</h2>
        <a class="text-link" href={url('collections/')}>
          All collections <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="topic-grid">
        {subjects.map((c) => <TopicTile collection={c} />)}
      </div>
    </div></div>
  </section>

  <section class="wrap" aria-labelledby="by-decade"><div class="section">
    <div class="section-head">
      <h2 id="by-decade">By decade</h2>
      <p>
        Films from the {decades[0]?.[0]}s to the {decades.at(-1)?.[0]}s.
      </p>
    </div>
    <div class="decades">
      {
        decades.map(([d, n]) => (
          <a href={url(`library/?decade=${d}`)}>
            <b>{d}s</b>
            <span>{plural(n, 'film')}</span>
          </a>
        ))
      }
    </div>
  </div></section>

  <section class="band" aria-labelledby="more-ways">
    <div class="wrap"><div class="section">
      <h2 id="more-ways">More ways in</h2>
      <div class="ways">
        <a href={url('saints/')}>
          <b>Saints</b>
          <span>Saints and blessed with films about them, with their dates and feast days.</span>
        </a>
        <a href={url('calendar/')}>
          <b>Calendar</b>
          <span>Films for the feasts of each month, following the calendar of 1962.</span>
        </a>
        <a href={url('guides/')}>
          <b>Guides</b>
          <span>Short essays comparing the films on Joan of Arc, Fátima, the Passion and more.</span>
        </a>
        <a href={url('family/')}>
          <b>Watching with children</b>
          <span>Recommended films by age, with the reason for each and its Legion of Decency rating.</span>
        </a>
        <a href={url('new/')}>
          <b>New films</b>
          <span>Films added since the library opened, newest first, with an RSS feed.</span>
        </a>
        <a href={url('not-included/')}>
          <b>Films not included</b>
          <span>Well-known films you might expect to find here, and why they are not listed.</span>
        </a>
      </div>
    </div></div>
  </section>

  <section class="wrap" aria-labelledby="approach"><div class="section approach">
    <h2 id="approach">How films are chosen</h2>
    <div>
      <p>
        A film is included when the Catholic faith is central to it: the Mass
        and the sacraments, a saint's life, a priest's or a nun's vocation, a
        persecution of the Church. A sympathetic priest in a supporting role is
        not enough. Films are judged by Catholic teaching as it was understood
        before the Second Vatican Council; that is a standard, not a date, so
        recent films qualify on the same terms as old ones.
      </p>
      <p>
        Each profile draws on published criticism, history and production
        records, and lists its sources. Where a film bends the facts, the
        profile says so.
      </p>
      <a class="text-link" href={url('principles/')}>
        Read how films are chosen <span aria-hidden="true">→</span>
      </a>
      <p class="grey-pointer">
        Some films are worth knowing about but come with a question attached: a
        reservation about their doctrine or history, or no independent review
        yet. They are kept apart, with the question set out on each page.
        <a class="text-link" href={url('grey-area/')}>
          The grey area <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div></section>
</Layout>
