{
  "name": "catholic-film-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "check": "astro check && node scripts/validate.mjs",
    "test": "node --test scripts/*.test.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "lint": "eslint scripts src/scripts astro.config.mjs eslint.config.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "catalogue": "node scripts/catalogue.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "astro": "^7.3.8",
    "typescript": "^6.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  }
}
